# Example only. Do not copy values from here: run setup.sh or setup.ps1, which writes
# deploy/.env with new random values. Every setting is listed with what it does.

# Password of the database's owner "ailms" (a superuser, used only at start-up).
POSTGRES_PASSWORD=
# Password of "ailms_app", the role the backend and worker use (no superuser rights).
APP_DB_PASSWORD=
# Signs sign-in codes; at least 32 characters.
SECRET_KEY=
# Keys of the object store that holds diagrams and other files.
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=

# Demo mode (ADR 0008 section G). Must be false for a deployment with real students.
DEMO_MODE=true
# true on a demo server reachable from the internet: demo entry needs DEMO_ACCESS_CODE,
# sign-up is closed and a banner says the site holds sample data only.
PUBLIC_DEMO=false
DEMO_ACCESS_CODE=
# Sign-up by email code for new students (only in demo mode on your own computer).
SIGNUP_OPEN=true

# Optional: use the published images instead of building them.
# AILMS_IMAGE_PREFIX=ghcr.io/OWNER/ailms
# AILMS_TAG=latest

# Optional, only for building on a network that inspects HTTPS: the proxy's root certificate.
# AILMS_EXTRA_CA=C:/path/to/company-root.pem
