{
	# Plain HTTP inside the Compose network. TLS, when hosted, ends in front of this container.
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		# Only this origin may supply scripts, styles, fonts, images and connections.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# For the container health check.
	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# The backend sets its own cache headers.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# File names under /assets carry a content hash, so they can be cached for a year.
	# A missing asset is a real 404, never the app page.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app: a real file if there is one, otherwise index.html.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
