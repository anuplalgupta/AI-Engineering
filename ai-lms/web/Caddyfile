{
	# Plain HTTP inside the Compose network. TLS, when hosted, ends in front of this container.
	admin off
	auto_https off
	servers {
		# Keep X-Forwarded-Proto/-For from a TLS proxy on a private network in front of us.
		trusted_proxies static private_ranges
		# The client address is the first untrusted one from the right, so a browser
		# cannot choose its own address by sending X-Forwarded-For.
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	header {
		# Only this origin may supply scripts, styles, fonts, images and connections.
		# style-src-attr allows the inline style attributes KaTeX uses to position maths;
		# attributes cannot run script. "?" keeps a stricter policy the backend sets
		# (for example the sandbox on an SVG from /api/media).
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# For the container health check.
	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# The backend sets its own cache headers. Caddy adds X-Forwarded-For, -Host and -Proto
	# (the scheme the browser used, passed through from a trusted proxy in front).
	handle /api/* {
		reverse_proxy http://backend:8000 {
			# The backend counts sign-in requests per client address (rate limits).
			header_up X-Real-IP {client_ip}
		}
	}

	# File names under /assets carry a content hash, so they can be cached for a year.
	# A missing asset is a real 404, never the app page.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app: a real file if there is one, otherwise index.html.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
